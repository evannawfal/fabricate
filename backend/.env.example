# Server configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/cpen321

# Google Auth 
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# JWT 
JWT_SECRET=your_jwt_secret_key_here

# Other API keys, secrets, and configurations

# File storage (private Azure Blob Storage container for clothing photos and avatar models).
# Uncomment and fill in to enable; without it, file features respond with 503.
# The connection string must include the account key. For the local Azurite emulator use: UseDevelopmentStorage=true
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=fabricate-files
