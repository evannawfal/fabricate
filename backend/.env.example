# Server configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/cpen321

# Google Auth 
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# JWT 
JWT_SECRET=your_jwt_secret_key_here

# Other API keys, secrets, and configurations

# File storage (private S3 bucket for clothing photos and avatar models).
# Uncomment and fill in to enable; without it, file features respond with 503.
# S3_BUCKET=your_bucket_name
# AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# Only for S3-compatible services other than AWS:
# S3_ENDPOINT=https://storage.googleapis.com
# S3_FORCE_PATH_STYLE=true
